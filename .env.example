# Copy this file to .env and fill in your own values.
# NEVER commit the real .env file - it contains secrets.
# These are the required variable NAMES for this project (no values here).

SUPABASE_PROJECT_ID=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=

# SportMonks Soccer API token (the sole data provider since the API-Football
# migration in Step 4). Get one from https://www.sportmonks.com.
SPORTMONKS_API_TOKEN=

# ---- Vercel deploy environment ----
# Set these (real values only, never committed here) as Vercel env vars before/at deploy.
# Server-side: read at runtime by the Nitro serverless function.
SPORTMONKS_API_TOKEN=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Build-time client env (VITE_* are inlined during `vite build`, so they must be set
# on Vercel as Preview/Production build env vars too, not just runtime):
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=
